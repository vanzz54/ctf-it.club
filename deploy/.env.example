# Salin file ini jadi `.env` lalu isi IP publik VPS kamu.
# Kalau kosong, deploy.sh akan mengisinya otomatis dari ifconfig.me
SERVER_IP=203.0.113.10

# Akun Admin Dashboard (http://<IP>:8080/admin.html) — hanya dibuat saat boot PERTAMA.
# Setelah ada, ganti password lewat dashboard: tab Peserta → Reset Password.
ADMIN_USER=admin
ADMIN_PASSWORD=admin123